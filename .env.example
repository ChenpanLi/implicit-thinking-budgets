# Copy to .env and fill in. .env is never committed.

# Where every dataset, batch, run, probe artefact and result lives.
RUN_DIR=/path/to/run-dir

# Only needed for the Claude Opus 5 runs (hosted through OpenRouter, billed per token).
OPENROUTER_API_KEY=

# Only needed if your Hugging Face cache needs a token to download the models.
HF_TOKEN=
